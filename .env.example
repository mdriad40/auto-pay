# Server Configuration
PORT=7000

# Supabase Configuration
SUPABASE_URL=https://your-supabase-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# =============================================================================
# Master bKash PGW Credentials (SECRET - SERVER ONLY - NEVER EXPOSE IN CLIENT)
